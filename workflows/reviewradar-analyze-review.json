    {
      "parameters": {
        "jsCode": "const ALLOWED_SENTIMENT = ['positive', 'neutral', 'negative'];\nconst ALLOWED_CATEGORY = ['size', 'fabric_quality', 'defect', 'delivery', 'not_as_photo', 'other'];\n\nconst raw = $json.choices?.[0]?.message?.content ?? '';\nconst cleaned = raw\n  .replace(/^\\s*\\x60{3}(?:json)?\\s*/i, '')\n  .replace(/\\s*\\x60{3}\\s*$/, '')\n  .trim();\n\nlet parsed = null;\nlet error = null;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  error = 'invalid_json';\n}\n\nif (error === null && (typeof parsed !== 'object' || parsed === null)) {\n  error = 'not_object';\n}\n\nif (error === null) {\n  if (!ALLOWED_SENTIMENT.includes(parsed.sentiment)) error = 'bad_sentiment';\n  else if (!ALLOWED_CATEGORY.includes(parsed.category)) error = 'bad_category';\n  else if (typeof parsed.summary !== 'string' || parsed.summary.trim() === '') error = 'bad_summary';\n  else if (typeof parsed.needs_reply !== 'boolean') error = 'bad_needs_reply';\n}\n\nconst provider = $prevNode.name === 'Ask OpenRouter' ? 'openrouter' : 'gigachat';\n\nreturn {\n  json: {\n    ok: error === null,\n    error,\n    provider,\n    analysis: error === null ? parsed : null,\n    raw_response: $json,\n  },\n};"
      },
