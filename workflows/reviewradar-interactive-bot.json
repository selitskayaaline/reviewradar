    {
      "parameters": {
        "jsCode": "const rawText = $json.message.text.trim();\nconst parts = rawText.split(/\\s+/);\n\n\nif (parts.length < 3) {\n    return { \n        json: { \n            error: true, \n            message: \"❌ Вы забыли ввести артикул, оценку или текст отзыва.\\nФормат: АРТИКУЛ ОЦЕНКА(1-5) ТЕКСТ\" \n        } \n    };\n}\n\nconst article = parts[0];\nconst ratingStr = parts[1];\nconst text = parts.slice(2).join(\" \");\n\n\nconst rating = parseInt(ratingStr, 10);\n\n\nif (isNaN(rating)) {\n    return { \n        json: { \n            error: true, \n            message: \"❌ Вы забыли ввести артикул, оценку или текст отзыва.\\nФормат: АРТИКУЛ ОЦЕНКА(1-5) ТЕКСТ\" \n        } \n    };\n}\n\n\nif (rating < 1 || rating > 5) {\n    return { \n        json: { \n            error: true, \n            message: \"❌ Оценка должна быть от 1 до 5.\" \n        } \n    };\n}\n\nreturn {\n    json: {\n        error: false,\n        article: article,\n        rating: rating,\n        text: text\n    }\n};"
      },
