      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst result = $json.result;\n\nif (!result || result.length === 0) {\n  return []; // Нет сообщений, стоп\n}\n\nconst lastMessage = result[result.length - 1];\nstaticData.offset = lastMessage.update_id + 1; // Запоминаем, что прочитали\n\nconst text = lastMessage.message?.text;\nconst chatId = lastMessage.message?.chat?.id;\n\nif (!text) return [];\n\nreturn { json: { text, chatId } };"
      },
